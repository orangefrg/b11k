# Only backend build inputs enter the image context.
*
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!web/
!web/**

# Tests, local output, and private files are not backend runtime inputs.
**/*_test.go
internal/testdb/
**/.DS_Store
**/.env
**/.env.*
**/secrets/
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.log
**/node_modules/
web/tests/
