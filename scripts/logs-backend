#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == --help ]]; then
  echo "Usage: ./scripts/logs-backend [Docker Compose logs options]"
  echo "Examples: ./scripts/logs-backend --follow; ./scripts/logs-backend --since 30m"
  exit 0
fi
source "$(dirname "$0")/lib/backend.sh"
require_backend
compose logs --tail 100 "$@" b11k-app
